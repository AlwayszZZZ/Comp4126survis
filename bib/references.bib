@article{chen2020review,
  title = {A Review of Thyroid Gland Segmentation and Thyroid Nodule Segmentation Methods for Medical Ultrasound Images},
  author = {Chen, Jian and You, Hao and Li, Kai},
  journal = {Computer Methods and Programs in Biomedicine},
  volume = {185},
  pages = {105329},
  year = {2020},
  doi = {10.1016/j.cmpb.2020.105329},
  url = {https://doi.org/10.1016/j.cmpb.2020.105329},
  keywords = {review-background, thyroid-ultrasound, thyroid-gland-segmentation, thyroid-nodule-segmentation, segmentation-review, traditional-methods, deep-learning},
  abstract = {This review summarizes thyroid gland and thyroid nodule segmentation methods for medical ultrasound images. It is used as a background paper for defining early segmentation approaches, including contour-based, region-based, machine-learning-based and deep-learning-based methods, and for identifying common challenges such as low contrast, speckle noise, weak boundaries and large variation in nodule shape.}
}

@article{das2024technical,
  title = {Deep Learning for Thyroid Nodule Examination: A Technical Review},
  author = {Das, Debottama and Iyengar, M. Sriram and Majdi, Mohammad S. and Rodriguez, Jeffrey J. and Alsayed, Mahmoud},
  journal = {Artificial Intelligence Review},
  volume = {57},
  number = {3},
  pages = {47},
  year = {2024},
  doi = {10.1007/s10462-023-10635-9},
  url = {https://doi.org/10.1007/s10462-023-10635-9},
  keywords = {review-background, thyroid-nodule-examination, deep-learning-review, thyroid-ultrasound, segmentation, detection-classification-context},
  abstract = {This technical review discusses deep learning methods for thyroid nodule examination. It covers a broader thyroid AI pipeline, including detection, classification and segmentation. In this literature review it is used as a recent seed review to understand current deep learning trends and to justify a narrower focus on ultrasound thyroid nodule segmentation.}
}

@article{kumar2020automated,
  title = {Automated Segmentation of Thyroid Nodule, Gland, and Cystic Components From Ultrasound Images Using Deep Learning},
  author = {Kumar, Viksit and Webb, John and Gregory, Amanda and Meixner, Dustin D. and Knudsen, Jessica M. and Callstrom, Matthew R. and Fatemi, Mostafa and Alizad, Azra},
  journal = {IEEE Access},
  volume = {8},
  pages = {63482--63496},
  year = {2020},
  doi = {10.1109/ACCESS.2020.2982390},
  url = {https://doi.org/10.1109/ACCESS.2020.2982390},
  keywords = {cnn-automated-segmentation, thyroid-ultrasound, thyroid-nodule-segmentation, thyroid-gland-segmentation, cnn, multi-output-segmentation, cystic-component, volume-estimation},
  abstract = {This paper proposes a multi-output convolutional neural network for automated segmentation of the thyroid gland, thyroid nodules and cystic components from ultrasound images. The model uses dilated convolutional layers and does not require a manual seed point. It was evaluated on 914 ultrasound images from 234 patients and supports segmentation, detection, size estimation and volume estimation.}
}

@article{sun2022tnsnet,
  title = {TNSNet: Thyroid Nodule Segmentation in Ultrasound Imaging Using Soft Shape Supervision},
  author = {Sun, Jian and Li, Chengfan and Lu, Zhen and He, Ming and Zhao, Ting and Li, Xue and Gao, Lijun and Xie, Kai and Lin, Tao and Sui, Jian and Xi, Qian and Zhang, Feng and Ni, Xiaohua},
  journal = {Computer Methods and Programs in Biomedicine},
  volume = {215},
  pages = {106600},
  year = {2022},
  doi = {10.1016/j.cmpb.2021.106600},
  url = {https://doi.org/10.1016/j.cmpb.2021.106600},
  keywords = {boundary-feature-enhanced, thyroid-ultrasound, thyroid-nodule-segmentation, deeplabv3plus, soft-shape-supervision, boundary, attention, dual-path-network},
  abstract = {This paper proposes TNSNet, a dual-path deep learning model for thyroid nodule segmentation in ultrasound images. It uses soft shape supervision and cross-path attention between region and shape paths to enhance boundary representation. The method was evaluated on 3786 ultrasound images using DSC, sensitivity, specificity and accuracy.}
}

@article{kunapinun2023gan,
  title = {Improving GAN Learning Dynamics for Thyroid Nodule Segmentation},
  author = {Kunapinun, Alisa and Dailey, Matthew N. and Songsaeng, Duangkamon and Parnichkun, Manukid and Keatmanee, Chotipat and Ekpanyapong, Mongkol},
  journal = {Ultrasound in Medicine \& Biology},
  volume = {49},
  number = {2},
  pages = {416--430},
  year = {2023},
  doi = {10.1016/j.ultrasmedbio.2022.09.010},
  url = {https://doi.org/10.1016/j.ultrasmedbio.2022.09.010},
  keywords = {robustness-generalization, thyroid-ultrasound, thyroid-nodule-segmentation, gan, deeplabv3plus, pid-control, adversarial-learning, hybrid-supervised-unsupervised},
  abstract = {This paper proposes StableSeg GAN for thyroid nodule segmentation. The model uses DeepLabV3+ as the generator and ResNet18 as the discriminator, while PID closed-loop control is used to stabilize GAN training and reduce mode collapse. The method combines supervised segmentation with adversarial learning to improve nodule shape consistency.}
}

@article{li2023btnet,
  title = {A Novel Model of Thyroid Nodule Segmentation for Ultrasound Images},
  author = {Li, Chengfan and Du, Rong and Luo, Qian and Wang, Rui and Ding, Xiaohong},
  journal = {Ultrasound in Medicine \& Biology},
  volume = {49},
  number = {2},
  pages = {489--496},
  year = {2023},
  doi = {10.1016/j.ultrasmedbio.2022.09.017},
  url = {https://doi.org/10.1016/j.ultrasmedbio.2022.09.017},
  keywords = {boundary-feature-enhanced, thyroid-ultrasound, thyroid-nodule-segmentation, boundary-attention, transformer, cnn-transformer, boundary-metrics, feature-fusion},
  abstract = {This paper proposes BTNet, a boundary attention transformer network for thyroid nodule segmentation in ultrasound images. The model combines CNN and transformer components in a U-Net-like architecture, uses boundary attention blocks and multi-feature fusion, and introduces boundary-specific metrics to evaluate contour quality.}
}

@article{ma2023symmetrical,
  title = {Symmetrical Awareness Network for Cross-Site Ultrasound Thyroid Nodule Segmentation},
  author = {Ma, Wei and Li, Xiaoyu and Zou, Lei and Fan, Chunyan and Wu, Ming},
  journal = {Frontiers in Public Health},
  volume = {11},
  pages = {1055815},
  year = {2023},
  doi = {10.3389/fpubh.2023.1055815},
  url = {https://doi.org/10.3389/fpubh.2023.1055815},
  keywords = {robustness-generalization, thyroid-ultrasound, thyroid-nodule-segmentation, domain-adaptation, cross-site, adversarial-learning, consistency-loss},
  abstract = {This paper proposes a symmetrical awareness network for cross-site ultrasound thyroid nodule segmentation. It addresses domain shift by combining bidirectional image translation, symmetrical segmentation modules, adversarial constraints and consistency loss to reduce domain gaps at both image and feature levels.}
}

@article{chen2024mlmseg,
  title = {MLMSeg: A Multi-View Learning Model for Ultrasound Thyroid Nodule Segmentation},
  author = {Chen, Guo and Tan, Guodong and Duan, Ming and Pu, Bin and Luo, Hong and Li, Sheng and Li, Kai},
  journal = {Computers in Biology and Medicine},
  volume = {169},
  pages = {107898},
  year = {2024},
  doi = {10.1016/j.compbiomed.2023.107898},
  url = {https://doi.org/10.1016/j.compbiomed.2023.107898},
  keywords = {boundary-feature-enhanced, thyroid-ultrasound, thyroid-nodule-segmentation, multi-view, transformer, graph-convolution, feature-fusion, graph-attention},
  abstract = {This paper proposes MLMSeg, a multi-view learning model for ultrasound thyroid nodule segmentation. It learns local visual features, global long-range dependencies and structural relationships between feature layers using CNN, multi-channel transformer, cross-layer graph convolution and channel-aware graph attention modules.}
}

@article{li2025hfa,
  title = {HFA-UNet: Hybrid and Full Attention UNet for Thyroid Nodule Segmentation},
  author = {Li, Yue and Zou, Yuanhao and He, Xiangjian and Xu, Qing and Liu, Ming and Jin, Shengji and Zhang, Qian and He, Maggie M. and Zhang, Jian},
  journal = {Knowledge-Based Systems},
  pages = {114245},
  year = {2025},
  doi = {10.1016/j.knosys.2025.114245},
  url = {https://doi.org/10.1016/j.knosys.2025.114245},
  keywords = {boundary-feature-enhanced, thyroid-ultrasound, thyroid-nodule-segmentation, u-net, attention, multi-scale-fusion, boundary-enhancement, cross-dataset-generalization},
  abstract = {This paper proposes HFA-UNet, a hybrid and full attention U-Net for ultrasound thyroid nodule segmentation. The model combines self-attention, spatial attention and channel attention, introduces full attention multi-scale fusion, and uses adaptive skip connections to improve boundary representation, noise suppression and cross-dataset generalization.}
}

@article{xiang2025federated,
  title = {Federated Learning via Multi-Attention Guided UNet for Thyroid Nodule Segmentation of Ultrasound Images},
  author = {Xiang, Zhuo and Tian, Xin and Liu, Yifan and Chen, Ming and Zhao, Chao and Tang, Lian Nian and Xue, Er Shuo and Zhou, Qi and Shen, Bo and Li, Feng and Chen, Qian and Xue, Hui Ying and Tang, Qing and Li, Yi Jing and Liang, Li and Wang, Bin and Li, Qing Si and Wu, Cai Jie and Ren, Ting Ting and Wu, Jia Yi and Wang, Tao and Liu, Wei Yang and Yan, Kai and Liu, Bao Jun and Sun, Li Ping and Zhao, Cong Kai and Xu, Hui Xiong and Lei, Bo},
  journal = {Neural Networks},
  volume = {181},
  pages = {106754},
  year = {2025},
  doi = {10.1016/j.neunet.2024.106754},
  url = {https://doi.org/10.1016/j.neunet.2024.106754},
  keywords = {robustness-generalization, thyroid-ultrasound, thyroid-nodule-segmentation, federated-learning, multi-center, attention, privacy-preserving, u-net},
  abstract = {This paper proposes a federated learning framework with a multi-attention guided U-Net for thyroid nodule segmentation in ultrasound images. It uses multi-scale cross-attention, dual attention in skip connections and FedAvg federated learning to improve multi-center generalization while protecting patient data privacy.}
}
